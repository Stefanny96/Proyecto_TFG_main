@page
<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Solicitud de Pedido</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="~/css/formulario.css" asp-append-version="true">
    <!-- Pongo "asp-append-version="true" Esto ayuda a evitar problemas de caché.-->
    <script src="~/js/jquery-3.7.1.min.js"></script>
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/js/formulario.js" asp-append-version="true"></script>
</head>

<body>
    <div class="container my-4">
        <h1 class="mb-4">Solicitud de Pedido</h1>

        <!-- Número y Fecha de Solicitud -->
        <div class="row justify-content-center mb-4">
            <div class="col-md-4">
                <div class="form-group">
                    <label for="numeroSolicitud">Número de Solicitud</label>
                    <input type="text" id="numeroSolicitud" class="form-control" readonly />
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <label for="fechaSolicitud">Fecha de Solicitud</label>
                    <input type="text" id="fechaSolicitud" class="form-control" readonly />
                </div>
            </div>
        </div>

        <!-- Información del solicitante y del proveedor -->
        <div class="row">
            <div class="col-md-6 mb-3">
                <h5>Información del Solicitante</h5>
                <label>Nombre</label>
                <input type="text" class="form-control" id="txtNombreSolicitante" placeholder="Nombre" readonly>
                <label class="mt-2">NIF/CIF</label>
                <input type="text" class="form-control" id="txtNifSolicitante" placeholder="NIF/CIF" readonly>
                <label class="mt-2">Email</label>
                <input type="text" class="form-control" id="txtEmailSolicitante" placeholder="Email"
                    value="prueba@gmail.com" readonly>
            </div>
            <div class="col-md-6 mb-3" id="contenedorProveedores">
                <h5>Información del Proveedor</h5>
                <label>Proveedor</label>
                <select class="form-control select2" id="selectProveedor" style="width: 100%;">
                    <option value="" disabled selected>Buscar proveedor...</option>
                </select>
                <!-- Contenedor para mostrar la información del proveedor -->
                <div class="col-md-6 mb-3" id="divInformacionProveedor"></div>
            </div>
        </div>

        <!-- Datos de Entrega -->
        <div class="row my-4">
            <h5>Datos de Entrega</h5>
            <div class="col-md-6 mb-3">
                <label for="direccionEntrega">Dirección de Entrega</label>
                <input type="text" class="form-control" id="direccionEntrega" placeholder="Dirección de Entrega">
                <div class="error" id="errorDireccionEntrega"></div>
            </div>
            <div class="col-md-6 mb-3">
                <label for="codigoPostal">Código Postal</label>
                <input type="text" class="form-control" id="codigoPostal" placeholder="Código Postal">
                <div class="error" id="errorCodigoPostal"></div>
            </div>
            <div class="col-md-6 mb-3">
                <label for="selectProvincias">Provincia</label>
                <select class="form-control select2" id="selectProvincias" style="width: 100%;">
                    <option value="" disabled selected>Seleccione provincia</option>
                </select>
                <div class="error" id="errorProvincia"></div>
            </div>
            <div class="col-md-6 mb-3">
                <label for="municipio">Municipio</label>
                <input type="text" class="form-control" id="municipio" placeholder="Municipio">
                <div class="error" id="errorMunicipio"></div>
            </div>
            <div class="col-md-6 mb-3">
                <label for="pais">País</label>
                <input type="text" class="form-control" id="pais" placeholder="País" value="España" readonly>
                <div class="error" id="errorPais"></div>
            </div>
            <div class="col-md-6 mb-3">
                <label for="telefono">Número de Teléfono</label>
                <input type="tel" class="form-control" id="telefono" placeholder="Número de Teléfono">
                <div class="error" id="errorTelefono"></div>
            </div>
            <div class="col-md-6 mb-3">
                <label for="fechaEntrega">Fecha Prevista de Entrega</label>
                <input type="text" id="fechaEntrega" class="form-control" placeholder="DD/MM/YYYY">
                <div id="errorFechaEntrega" class="text-danger error"></div>
            </div>
            <div class="col-md-6 mb-3">
                <label for="metodoPago">Método de Pago</label>
                <select class="form-control" id="metodoPago">
                    <option value="" disabled selected>Selecciona un método de pago</option>
                    <option value="tarjeta">Tarjeta de Crédito</option>
                    <option value="transferencia">Transferencia Bancaria</option>
                </select>
                <div class="error" id="errorMetodoPago"></div>
            </div>

            <!-- Aquí se mostrarán los datos ingresados -->
            <div id="datosTarjeta" class="mt-4"></div>

            <!-- Modal -->
            <div class="modal fade" id="tarjetaModal" tabindex="-1" aria-labelledby="tarjetaModalLabel"
                aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="tarjetaModalLabel">Datos de Tarjeta de Crédito</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <div class="modal-body">
                            <form id="formTarjeta">
                                <div class="mb-3">
                                    <label for="nombreTitular" class="form-label">Nombre del Titular</label>
                                    <input type="text" class="form-control" id="nombreTitular"
                                        placeholder="Nombre y Apellidos" required>
                                </div>
                                <div class="mb-3">
                                    <label for="numeroTarjeta" class="form-label">Número de Tarjeta</label>
                                    <input type="text" class="form-control" id="numeroTarjeta"
                                        placeholder="1234 5678 9012 3456" maxlength="19" required>
                                </div>
                                <div class="mb-3">
                                    <label for="fechaExpiracion" class="form-label">Fecha de Expiración (MM/YY)</label>
                                    <input type="text" class="form-control" id="fechaExpiracion" placeholder="MM/YY"
                                        maxlength="5" required>
                                </div>
                                <div class="mb-3">
                                    <label for="cvv" class="form-label">CVV</label>
                                    <input type="password" class="form-control" id="cvv" placeholder="123" maxlength="3"
                                        required>
                                </div>
                                <button type="submit" class="btn btn-primary w-100">Guardar</button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal fade" id="transferenciaModal" tabindex="-1" aria-labelledby="transferenciaModalLabel"
                aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form id="formTransferencia">
                            <div class="modal-header">
                                <h5 class="modal-title" id="transferenciaModalLabel">Datos de la Transferencia Bancaria
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"
                                    aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <div class="mb-3">
                                    <label for="cuentaOrigen" class="form-label">Cuenta de Origen (IBAN)</label>
                                    <input type="text" class="form-control" id="cuentaOrigen"
                                        placeholder="Ej: ES91 2100 0418 4502 0005 1332" required>
                                </div>
                                <div class="mb-3">
                                    <label for="titularCuenta" class="form-label">Titular de la Cuenta</label>
                                    <input type="text" class="form-control" id="titularCuenta"
                                        placeholder="Nombre completo" required>
                                </div>
                                <div class="mb-3">
                                    <label for="numeroIban" class="form-label">Cuenta de Destino (IBAN)</label>
                                    <input type="text" class="form-control" id="cuentaDestino"
                                        placeholder="Ej: ES91 2100 0418 4502 0005 1332" required>
                                </div>
                                <div class="mb-3">
                                    <label for="codigoBic" class="form-label">Código BIC/SWIFT (opcional)</label>
                                    <input type="text" class="form-control" id="codigoBic"
                                        placeholder="Ej: BBVAESMMXXX">
                                </div>
                                <div class="mb-3">
                                    <label for="bancoBeneficiario" class="form-label">Banco Beneficiario</label>
                                    <input type="text" class="form-control" id="bancoBeneficiario"
                                        placeholder="Nombre del banco" required>
                                </div>
                                <div class="mb-3">
                                    <label for="montoTransferencia" class="form-label">Monto a Transferir</label>
                                    <input type="number" class="form-control" id="montoTransferencia" min="0.01"
                                        step="0.01" placeholder="Ej: 100.00" required>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary"
                                    data-bs-dismiss="modal">Cancelar</button>
                                <button type="submit" class="btn btn-primary">Guardar</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
            <div id="datosTransferencia" class="mt-3"></div>


        </div>


        <!-- Detalles del Pedido -->
        <h5 class="my-4">Detalles del Pedido</h5>
        <table class="table" id="tablaPedido">
            <thead id="cabeceraPedido">
                <tr>
                    <th>Código producto</th>
                    <th>Descripción producto</th>
                    <th>Cantidad</th>
                    <th>Precio unitario</th>
                    <th>Subtotal</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody id="detallePedido">

            </tbody>
        </table>

        <!-- Botón para agregar linea -->
        <button type="button" class="btn btn-primary mt-3 me-3" onclick="agregarLinea()">Agregar Línea</button>

        <!-- Total del pedido -->
        <div class="mt-3">
            <label for="totalPedido">Total Pedido:</label>
            <div class="input-precio">
                <input type="number" id="totalPedido" class="form-control" readonly />
                <span class="simbolo-euro">€</span>
                <div class="error" id="errorTotalPedido"></div>
            </div>
        </div>

        <!-- Botón para enviar solicitud -->
        <button type="button" class="btn btn-success mt-3" onclick="validarDatosEntrega()">Enviar Solicitud</button>
    </div>
</body>

</html>